# Database (SQLite is created automatically in backend/ by default)
DATABASE_URL=sqlite:///./agentpay.db

# PayPal Sandbox credentials. Leave blank to use the local simulated payment adapter.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/payment/return
PAYPAL_CANCEL_URL=http://localhost:5173/contract

# Local development server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAX_CSV_SIZE_MB=5
